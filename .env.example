MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
# Empty = all non-system databases (choose one in the sidebar); or set one name to lock the app to it
MYSQL_DATABASE=
# true for cloud MySQL such as TiDB Cloud (port 4000)
MYSQL_SSL=false

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
